# ===== 後端（Render 服務設定頁填，或本機 .env）=====
PORT=3180
# 允許連線的前端來源（GitHub Pages 網址，不含路徑）。本機開發可留空（預設 *）。
ALLOW_ORIGIN=https://your-name.github.io

# ===== 前端（GitHub Pages 建置時注入）=====
# 在 repo 的 Settings → Variables 設 GAME_SERVER_URL，值為 Render 後端的 HTTPS 網址。
# 本機用 `npm start` 直接開 http://localhost:3180 時不需要設定（同源）。
GAME_SERVER_URL=http://localhost:3180
